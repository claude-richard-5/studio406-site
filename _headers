# Cloudflare (Workers static assets) reads this file to set response headers.
# Everything revalidates while the new public site is still being iterated on,
# so edits show up immediately without a hard refresh. Once the design settles,
# /img/* can move to long caching.

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/img/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

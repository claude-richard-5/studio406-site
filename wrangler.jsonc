{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio406-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "ACCESS_RL",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

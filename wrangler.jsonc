{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio406-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "ACCESS_MAILER",
      "destination_address": "access@studio406.co"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
